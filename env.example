# Copy this file to .env and fill in your own values.
# NEVER commit your .env file to GitHub.

# Port the Express server listens on
PORT=5000

# MongoDB Atlas connection string (Cluster > Connect > "MongoDB for VS Code")
# Replace <username>, <db_password>, <cluster_host> and <db_name> with your values.
MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster_host>/<db_name>

# JSONwebtoken secret for encryption
JWT_SECRET=128characterstring

# Front-end origin allowed by CORS (e.g. your React/Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# development | production for Render
NODE_ENV=development
